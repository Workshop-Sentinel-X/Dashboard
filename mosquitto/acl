# ESP8266 : publie la télémétrie signée (HMAC) uniquement
user esp01
topic write sentinel/telemetry

# Service FastAPI : vérifie la signature, republie les données validées, lève les alertes cyber
user api
topic read sentinel/telemetry
topic read sentinel/scores
topic read sentinel/alerts
topic write sentinel/validated
topic write sentinel/alerts
# IA 2 tourne dans l'API : l'API publie son score
topic write sentinel/scores

# Moteur IA capteurs (Isolation Forest)
user ia
topic read sentinel/validated
topic write sentinel/scores
topic write sentinel/alerts

# Moteur IA vision (YOLOv8n)
user vision
topic write sentinel/alerts

# Telegraf : lit tout ce qui alimente le dashboard
user telegraf
topic read sentinel/validated
topic read sentinel/scores
topic read sentinel/alerts
