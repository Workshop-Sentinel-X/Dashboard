        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sentinelx"
          },
          "query": "import \"array\"\r\n\r\nalerts = from(bucket: \"telemetry\")\r\n  |> range(start: -30s)\r\n  |> filter(fn: (r) => r._measurement == \"alerts\" and r._field == \"event\")\r\n  |> group()\r\n  |> count()\r\n  |> map(fn: (r) => ({_time: now(), _value: float(v: r._value)}))\r\n\r\nzero = array.from(rows: [{_time: now(), _value: 0.0}])\r\n\r\nunion(tables: [alerts, zero])\r\n  |> group()\r\n  |> sum()\r\n  |> map(fn: (r) => ({_time: now(), _value: if r._value > 0.0 then 1.0 else 0.0}))",
          "refId": "A"
        }
      ],
      "title": "Etat global",
      "type": "stat"
    },
