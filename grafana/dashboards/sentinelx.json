    {
      "id": 15,
      "type": "table",
      "title": "Dernières alertes",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sentinelx"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sentinelx"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alerts\" and r._field == \"message\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 15)\n  |> keep(columns: [\"_time\", \"code\", \"source\", \"severity\", \"_value\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "_time": "heure",
              "_value": "message"
            },
            "indexByName": {
              "_time": 0,
              "code": 1,
              "severity": 2,
              "source": 3,
              "_value": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "code"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "INTRUSION": {
                        "color": "red",
                        "index": 0
                      },
                      "CYBER_SPOOFING": {
                        "color": "purple",
                        "index": 1
                      },
                      "ANOMALY": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
